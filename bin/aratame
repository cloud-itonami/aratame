#!/usr/bin/env nbb
;; aratame CLI launcher.
;;
;; Self-locating so the command works from any directory: it resolves the repo
;; root from its own path and re-invokes nbb with this repo's src on the
;; classpath. Written in nbb rather than sh per the repo-wide script-host rule
;; (ADR-2607173000; sh is not used for new scripts).
(ns aratame.bin.launcher
  (:require ["node:child_process" :as cp]
            ["node:path" :as path]
            [clojure.string :as str]
            [nbb.core :as nbb]))

(def root (path/dirname (path/dirname nbb/*file*)))

(defn- lib-classpath
  "aratame's own src plus the two kotoba-lang libraries it delegates to:
  macos-inventory (signing / provenance / XProtect probes) and quarantine
  (the reversible enforcement that the :quarantine action names)."
  []
  (str/join ":" [(path/join root "src")
                 (path/resolve root ".." ".." "kotoba-lang" "macos-inventory" "src")
                 (path/resolve root ".." ".." "kotoba-lang" "quarantine" "src")]))

(def result
  (cp/spawnSync "nbb"
                (clj->js (concat ["--classpath" (lib-classpath)
                                  "-m" "aratame.host.cli"]
                                 *command-line-args*))
                #js {:stdio "inherit"}))

(set! (.-exitCode js/process) (or (.-status result) 1))
